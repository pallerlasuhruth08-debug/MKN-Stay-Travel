# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co

# The SERVICE ROLE key, not the anon/publishable key. It bypasses Row Level
# Security, which is required here (RLS denies anon/authenticated on every
# mkn_* table and the ID-upload storage bucket by design). Never expose this
# key to a browser — it only belongs in server-side env vars.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
